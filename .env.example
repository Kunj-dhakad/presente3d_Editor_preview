# This app is only the presentation editor and preview. The PHP app (CI_Core)
# owns users, presentations and the database, and opens these pages in an iframe.

# This app's public URL. Files it stores (PPT exports, AI images) are linked
# with it, because the PHP app opens them from another domain.
APP_URL=http://localhost:3000

# Key PHP signs editor tokens with (encrypt_user_token in
# application/helpers/tokengenerate_helper.php). Leave empty to use PHP's default.
PHP_TOKEN_KEY=

# Comma-separated origins of the PHP pages that may send INIT_DATA, e.g.
# https://present3d.com,https://*.present3d.com  — empty accepts any (development only).
NEXT_PUBLIC_PARENT_ORIGINS=
# Extra pages allowed to frame this app (space separated); PHP domains are in next.config.ts.
FRAME_ANCESTORS=

# S3 for files this app makes (PPT exports, AI images, background removal).
KD_AWS_REGION=us-east-1
KD_AWS_S3_BUCKET_NAME=
KD_AWS_ACCESS_KEY_ID=
KD_AWS_SECRET_ACCESS_KEY=
# Key prefix in the bucket.
STORAGE_PREFIX=ppt_editor_data

# AI and media services
OPENAI_API_KEY=
MODELSLAB_API_KEY=
PEXELS_API_KEY=
SPEECHIFY_API_KEY=
# AI requests per user per day (in-memory limit).
AI_DAILY_LIMIT=300

# Branding
NEXT_PUBLIC_APP_NAME=Present 3D
