# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Only what the server needs to install, build and run the app is committed:
# app/, modules/, public/, database/, scripts/setup.cjs, package files and config.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/
/artifacts/
/verify-preview.cjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.zip
*.log
*.tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: secrets stay on each machine; the empty template is kept
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors and AI assistants
/.vscode/
/.idea/
/.claude/
/AGENTS.md
/CLAUDE.md

# docs and notes
/docs/

# one-off developer scripts (only scripts/setup.cjs runs on the server: npm run db:setup)
/scripts/*
!/scripts/setup.cjs
!/scripts/amplify-env.cjs
!/scripts/build-ppt-lambda.mjs

# ppt-export Lambda build output (npm run build:ppt-lambda)
/lambda/ppt-export/dist/
